<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose handles all theming; this XML theme is only used for the
         system window chrome (status bar, navigation bar) before Compose
         takes over. It inherits from a transparent no-action-bar base. -->
    <style name="Theme.Cyclewise" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
